# Telegram
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_BOT_TOKEN=123456789:telegram_bot_token_here
OWNER_ID=123456789
# Optional: comma-separated group/chat IDs whose members can use /release.
# Admin commands stay owner-only.
# AUTHORIZED_CHAT_IDS=-1001234567890,-1009876543210

# Jackett
JACKETT_URL=http://localhost:9117
JACKETT_API_KEY=your_jackett_api_key_here

# Optional: releases shown per page. Defaults to 10.
# MAX_RESULTS=10

# Optional: seconds before a search result message is redacted automatically.
# Defaults to 300. Set to 0 to keep results until they are closed manually.
# SEARCH_REDACT_SECONDS=300

# Optional: SQLite file storing IDs authorized at runtime with /auth.
# Defaults to ./jackettbot.db.
# DATABASE_PATH=jackettbot.db
